{
  "manifest_version": 3,
  "name": "Anker Turbo Background Review",
  "version": "2.2.1",
  "description": "Anker Turbo Background Review with concurrent task queue.",
  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://aidc-annotation-us.anker-in.com/*",
    "https://aidc-annotation-eu.anker-in.com/*",
    "https://aidc-annotation-cn.anker-in.com/*"
  ],
  "action": {
    "default_title": "Anker Turbo",
    "default_popup": "dist/popup.html"
  },
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://aidc-annotation-us.anker-in.com/*",
        "https://aidc-annotation-eu.anker-in.com/*",
        "https://aidc-annotation-cn.anker-in.com/*"
      ],
      "js": [
        "dist/src/shared/namespace.js",
        "dist/src/shared/constants.js",
        "dist/src/shared/settings.js",
        "dist/src/shared/logger.js",
        "dist/content/api-hook.js",
        "dist/content/annotation-watcher.js",
        "dist/content/video-preload.js",
        "dist/src/content/task/video-speed.js",
        "dist/src/content/task/hotkeys.js",
        "dist/src/content/task/counter.js",
        "dist/src/content/task/anti-idle.js",
        "dist/src/content/task/submit-shortcut.js",
        "dist/src/content/task/index.js",
        "dist/src/content/worker/review-rows.js",
        "dist/src/content/worker/review-url.js",
        "dist/src/content/worker/ui.js",
        "dist/main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://aidc-annotation-us.anker-in.com/*",
        "https://aidc-annotation-eu.anker-in.com/*",
        "https://aidc-annotation-cn.anker-in.com/*"
      ],
      "js": [
        "dist/src/shared/namespace.js",
        "dist/src/shared/constants.js",
        "dist/src/shared/settings.js",
        "dist/bridge.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}